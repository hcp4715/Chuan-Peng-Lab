@article{__2026-2,
	title = {漂移扩散模型的理论基础及其合理使用的路径},
	url = {https://chinaxiv.org/abs/202601.00206},
	doi = {10.12074/202601.00206},
	abstract = {漂移扩散模型被广泛应用于不同领域的反应时分析。然而，当前文献缺少对\&nbsp;DDM\&nbsp;的数学模型、参数估计算法和工具及如何合理使用的系统阐述。本文首先回顾了\&nbsp;DDM\&nbsp;的数学基础——首次通过时间函数，强调\&nbsp;DDM\&nbsp;从统计模型到认知模型这一逻辑飞跃中的关键模型预设，简述\&nbsp;DDM\&nbsp;参数估计的算法及其软件实现；在此基础上强调模型预设对实验任务设计与参数解读的约束，并指出两种可能使用\&nbsp;DDM\&nbsp;的路径：严格使用标准\&nbsp;DDM\&nbsp;或者对其进行拓展。},
	journal = {应用心理学},
	author = {{王琪惠} and {任子伟} and {胡传鹏} and {王益文}},
	year = {2026},
	keywords = {决策, 漂移扩散模型, 证据积累模型},
}
